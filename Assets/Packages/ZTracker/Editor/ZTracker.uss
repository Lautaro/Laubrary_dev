.tracker-cell { height: 20px; min-height: 20px; margin: 0; padding: 0; font-size: 11px; white-space: nowrap; overflow: hidden; -unity-text-align: middle-center; }
.tracker-row-number { width: 28px; min-width: 28px; height: 20px; font-size: 11px; margin: 0; padding: 0; -unity-text-align: middle-center; }
.tracker-track-header { font-size: 11px; margin: 0; padding-left: 3px; white-space: nowrap; overflow: hidden; -unity-text-align: middle-left; }
/* A beat row's tint must lose to the selection, and the selection to the cursor (.tracker-compact .tracker-picked below). */
.tracker-beat { background-color: rgba(130, 130, 130, 0.08); }
.tracker-selected, .tracker-cell.tracker-selected { background-color: rgba(90, 145, 200, 0.3); }
.tracker-cell.tracker-picked, .tracker-picked { background-color: var(--zui-accent); color: white; }
.tracker-playing { border-bottom-width: 1px; border-bottom-color: var(--zui-accent); }
.tracker-grid-row { flex-direction: row; flex-wrap: nowrap; flex-shrink: 0; height: 22px; }
.tracker-track-gap { margin-right: 12px; }
.tracker-compact .tracker-flow { margin: 0; padding: 0; }
.tracker-compact .zui-button { min-height: 22px; height: 22px; margin: 1px; padding-left: 5px; padding-right: 5px; }
.tracker-compact .zui-box { margin: 4px 5px; padding: 5px; }
.tracker-compact .zui-box__body { padding: 4px 2px; }
.tracker-compact .zui-box__caret { display: none; }
.tracker-compact .zs-chain-editor__fold-caret { display: none; }
.tracker-compact .zui-box__titlerow { min-height: 22px; }
.tracker-compact .zui-section { margin: 5px 4px; }
.tracker-compact .zui-button, .tracker-compact .zui-togglebutton, .tracker-compact .zui-segmented Button, .tracker-compact .zui-miniradio Button { --zui-button-metallic-strength: 0; min-height: 20px; height: 20px; padding: 0 5px; margin: 1px 2px; border-top-width: 0; border-bottom-width: 0; border-left-width: 0; border-right-width: 0; border-top-left-radius: 2px; border-top-right-radius: 2px; border-bottom-left-radius: 2px; border-bottom-right-radius: 2px; background-color: rgba(115, 148, 171, 0.16); }
.tracker-compact .zui-button:hover, .tracker-compact .zui-togglebutton:hover { background-color: rgba(126, 174, 207, 0.26); }
.tracker-compact .zui-togglebutton--on, .tracker-compact .tracker-picked { background-color: rgba(83, 163, 210, 0.45); }
.tracker-compact .tracker-visibility-toggles { flex-direction: row; flex-wrap: nowrap; margin: 2px 0; }
.tracker-compact .tracker-visibility-toggles .zui-togglebutton { width: 24px; min-width: 24px; height: 18px; min-height: 18px; margin: 0; padding: 0 2px; font-size: 10px; border-top-left-radius: 0; border-top-right-radius: 0; border-bottom-left-radius: 0; border-bottom-right-radius: 0; }
.tracker-compact .zui-iconbtn { width: 23px; min-width: 23px; height: 23px; min-height: 23px; padding: 2px; margin: 1px; }
.tracker-compact .zui-button-link { background-color: transparent; }
.tracker-compact .tracker-drum-source { height: 20px; min-height: 20px; padding: 0 3px; font-size: 11px; }
.tracker-track-row { height: 23px; min-height: 23px; -unity-text-align: middle-left; }
.tracker-status-line { height: 20px; min-height: 20px; flex-shrink: 0; margin: 0; padding-left: 4px; font-size: 11px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.tracker-axis-label { font-size: 10px; margin: 0; padding: 0; -unity-text-align: middle-left; }
.tracker-zone-label { font-size: 11px; margin: 0; padding: 2px; color: white; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
/* Track FX columns: −/+ and +N on the track header, +N row markers in the track gutter, bound columns and bar view. */
.tracker-header-glyph { font-size: 12px; color: rgb(220, 220, 220); background-color: rgba(0, 0, 0, 0.18); }
.tracker-header-glyph:hover { background-color: rgba(255, 255, 255, 0.16); }
.tracker-fx-overflow { color: rgb(236, 176, 72); font-size: 10px; -unity-text-align: middle-left; background-color: rgba(0, 0, 0, 0); }
.tracker-fx-title-bound { color: rgb(150, 205, 240); }
.tracker-cell.tracker-bound-id { color: rgba(200, 200, 200, 0.45); }
/* Another command inside a bound column keeps its own colours; an amber rule above and below marks it. */
.tracker-cell.tracker-bound-other { border-top-width: 1px; border-bottom-width: 1px; border-top-color: rgb(236, 176, 72); border-bottom-color: rgb(236, 176, 72); }
.tracker-fx-bar { background-color: rgba(120, 190, 235, 0.85); }
.tracker-cell.tracker-header-glyph-half { height: 10px; min-height: 10px; font-size: 10px; padding: 0; -unity-text-align: middle-center; }
/* Envelope columns (T-0601): their header +/− in the envelope accent, so they read apart from the FX ones beside them. */
.tracker-cell.tracker-header-glyph-env { color: rgb(120, 222, 200); }
.tracker-cell.tracker-env-title { -unity-text-align: middle-center; }
/* Command suggestions (T-0599): a compact list under (or over) the cell being typed; colours come from the command look (T-0600). */
.tracker-suggest { padding: 2px; }
.tracker-suggest__head { flex-direction: row; height: 16px; min-height: 16px; flex-shrink: 0; padding: 0 3px; }
.tracker-suggest__query { flex-grow: 1; flex-shrink: 1; margin: 0; padding: 0; font-size: 11px; -unity-font-style: bold; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; -unity-text-align: middle-left; }
.tracker-suggest__tally { flex-shrink: 0; margin: 0; padding: 0; font-size: 10px; color: rgba(210, 210, 210, 0.6); -unity-text-align: middle-right; }
.tracker-suggest__row { flex-direction: row; height: 18px; min-height: 18px; flex-shrink: 0; align-items: center; padding: 0 3px; border-top-left-radius: 2px; border-top-right-radius: 2px; border-bottom-left-radius: 2px; border-bottom-right-radius: 2px; }
.tracker-suggest__row--hl { background-color: rgba(83, 163, 210, 0.45); }
.tracker-suggest__chip { width: 24px; min-width: 24px; height: 15px; margin: 0 5px 0 0; padding: 0; font-size: 11px; -unity-font-style: bold; -unity-text-align: middle-center; background-color: rgb(40, 40, 40); border-top-left-radius: 2px; border-top-right-radius: 2px; border-bottom-left-radius: 2px; border-bottom-right-radius: 2px; }
.tracker-suggest__name { flex-grow: 1; flex-shrink: 1; margin: 0; padding: 0; font-size: 11px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; -unity-text-align: middle-left; }
.tracker-suggest__scope { flex-shrink: 0; width: 62px; margin: 0 0 0 4px; padding: 0; font-size: 10px; color: rgba(210, 210, 210, 0.6); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; -unity-text-align: middle-right; }
.tracker-suggest__more { height: 14px; margin: 0; padding: 0 3px; font-size: 10px; color: rgba(210, 210, 210, 0.6); }
/* Song › Commands colour swatch. */
.tracker-command-color { width: 34px; min-width: 34px; height: 18px; margin: 0 4px 0 2px; }
