      satMod: 0.05
      valMod: -0.08
    - name: Deep
      hueMod: 0
      satMod: 0.1
      valMod: -0.15
    - name: Edge
      hueMod: 0
      satMod: 0.2
      valMod: -0.1
  - name: Accent
    color: {r: 0.2, g: 0.38, b: 0.55, a: 1}
