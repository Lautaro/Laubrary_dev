/* Foundation container presentation. Coordinator attaches this sheet after the legacy toolkit sheet.
   Every selector targets a semantic part class, so a tool root such as .lau-tool-zounds can override it
   with an ordinary descendant selector without control code learning the tool identity. */

.zui-box__headercontent {
    flex-direction: row;
    align-items: center;
}

.zui-box__headerlead {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
}

.zui-box__gear {
    margin-left: auto;
    font-size: 12px;
}

.zui-box__settings {
    margin-top: 0;
    margin-bottom: 6px;
}

.zui-box__settings-caption {
    margin-bottom: 2px;
}

.zui-box__settings-toggle {
    margin-top: 1px;
    margin-bottom: 1px;
}

.zui-box__settings-toggle--group {
    margin-top: 2px;
}

.zui-box__settings-group-label {
    -unity-font-style: bold;
}

.zui-section__headerbtn {
    margin-left: 6px;
    width: 20px;
    height: 15px;
    justify-content: center;
    align-items: center;
    background-color: rgba(255, 255, 255, 0.07);
    border-top-left-radius: 3px;
    border-top-right-radius: 3px;
    border-bottom-left-radius: 3px;
    border-bottom-right-radius: 3px;
}

.zui-section__toggle {
    margin-top: 0;
    margin-bottom: 0;
    margin-left: 0;
    margin-right: 4px;
}
