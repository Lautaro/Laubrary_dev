/* UI-separation pilot: static presentation for legacy painted standard controls only.
   Compound selectors keep these rules away from skin sliders and other controls that share semantic aliases. */
.zui-microslider.zui-slider,
.zui-microminmax.zui-range {
    height: 18px;
    min-width: 60px;
    border-radius: 3px;
    overflow: hidden;
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    border-width: 1px;
    border-color: var(--zui-line);
}

.zui-microslider.zui-slider {
    --zui-slider-fill-left: rgba(28, 44, 78, 0.92);
    --zui-slider-fill-right: rgba(70, 120, 200, 0.85);
    --zui-slider-track-color: rgba(0, 0, 0, 0.30);
}

.zui-microminmax.zui-range {
    --zui-range-fill-left: rgba(28, 44, 78, 0.92);
    --zui-range-fill-right: rgba(70, 120, 200, 0.85);
    --zui-range-track-color: rgba(0, 0, 0, 0.30);
}

.zui-microslider.zui-slider > .zui-slider__label,
.zui-microminmax.zui-range > .zui-range__label {
    position: absolute;
    left: 6px;
    font-size: 11px;
    -unity-text-align: middle-left;
}

.zui-microslider.zui-slider > .zui-slider__value,
.zui-microminmax.zui-range > .zui-range__value {
    position: absolute;
    right: 6px;
    font-size: 11px;
    opacity: 0.85;
    -unity-text-align: middle-right;
}

.zui-microslider.zui-slider > .zui-slider__value { display: none; }

.zui-microslider.zui-slider > .zui-slider__input {
    position: absolute;
    right: 2px;
    top: 1px;
    bottom: 1px;
    width: 46px;
    margin-left: 0;
    margin-right: 0;
    display: none;
}

.zui-microslider.zui-slider.zui-slider--show-value > .zui-slider__value { display: flex; }
.zui-microslider.zui-slider.zui-slider--show-input > .zui-slider__value { display: none; }
.zui-microslider.zui-slider.zui-slider--show-input > .zui-slider__input { display: flex; }

.zui-togglebutton.zui-toggle {
    -unity-font-style: normal;
    padding-left: 8px;
    padding-right: 8px;
    padding-top: 2px;
    padding-bottom: 2px;
    border-radius: 3px;
    background-color: var(--zui-bg-inset);
    border-width: 1px;
    border-color: var(--zui-line);
    flex-shrink: 0;
}

.zui-togglebutton.zui-toggle:hover { background-color: rgba(255, 255, 255, 0.06); }
.zui-togglebutton.zui-toggle.zui-togglebutton--on {
    background-color: var(--zui-accent-soft);
    border-color: var(--zui-accent);
    -unity-font-style: bold;
}
