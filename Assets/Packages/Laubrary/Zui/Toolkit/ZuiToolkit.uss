/* ZuiToolkit.uss — the single shared stylesheet for the UI Toolkit half of ZUI (Laubrary.Zui).
   Styling decision (2026-07-23, user-confirmed): hand-authored USS with custom properties as the
   palette — no ZUIStyleSheetAsset/Zheet layer underneath. Tune the look here, once, for every tool. */

.zui-root {
    --zui-accent: rgb(90, 160, 255);
    --zui-accent-soft: rgba(90, 160, 255, 0.35);
    --zui-line: rgba(128, 128, 128, 0.4);
    --zui-bg-inset: rgba(0, 0, 0, 0.18);
    /* Sub-section fills — nesting depth is shown by tone rather than by stacking borders. */
    --zui-sub-fill: rgba(0, 0, 0, 0.16);
    --zui-sub-fill-2: rgba(0, 0, 0, 0.28);
    /* Section headings: bright, with a slight cyan cast so a heading reads as structure at a glance
       and never gets mistaken for a field label. Tune the whole toolkit's heading colour here. */
    --zui-section-title: rgb(0, 255, 0);
    --zui-stage-bg: rgb(26, 26, 31);
    padding: 4px;
}

/* NOTE: no flex-grow/height on .zui-root itself — it's applied to a window's rootVisualElement,
   which Unity already sizes to the window's content area (window minus tab header). Forcing growth
   there once made every window's content exactly one header-height too tall (measured 2026-07-23). */

/* Every BaseField-derived control (FloatField, Slider, Toggle, ObjectField...) defaults to
   flex-grow:1 inside a flex row — exactly the "stretches to fill whatever's left" behavior the
   layout rules forbid. Controls are only ever as wide as their explicit width. */
.zui-root .unity-base-field {
    flex-grow: 0;
    flex-shrink: 0;
    margin-left: 0;
}

/* Built-in BaseField labels (Toggle etc.) reserve a ~150px fixed column by default — size them to
   their own text instead, matching the Zui.Field wrap philosophy. */
.zui-root .unity-base-field__label {
    min-width: auto;
    margin-right: 4px;
}

/* flex-grow:0 only governs the MAIN axis. A control sitting in a column still stretches across the
   CROSS axis (its width) unless told otherwise — which for a Toggle means a 700px-wide click target
   for a 12px checkbox, and an over-width audit finding. Size it to its own content instead. Inside a
   row the cross axis is height, so there it keeps the row's vertical centring. */
.zui-root .unity-toggle {
    align-self: flex-start;
}

.zui-root .zui-row .unity-toggle,
.zui-root .zui-field .unity-toggle {
    align-self: center;
}

/* Containers ------------------------------------------------------------- */

.zui-box {
    border-width: 1px;
    border-color: var(--zui-line);
    border-radius: 3px;
    padding: 6px;
    margin-bottom: 6px;
}

/* A box INSIDE a box is a sub-section: drop the frame and tint the background instead. Two nested
   borders read as noise — the eye has to work out which frame owns which content, and a third level
   is nearly unreadable. A darker fill groups just as clearly while staying quiet, and it nests
   naturally: each level sits a little deeper than its parent. Depth is expressed by TONE, not by
   accumulating outlines. */
.zui-box .zui-box {
    border-width: 0;
    background-color: var(--zui-sub-fill);
    padding: 5px;
}

.zui-box .zui-box .zui-box {
    background-color: var(--zui-sub-fill-2);
}

/* A titled sub-section still needs its title to read as a heading, but one step quieter than a
   top-level section title so the hierarchy stays legible. */
.zui-box .zui-box > .zui-box__titlerow > .zui-box__title {
    opacity: 0.85;
}

.zui-box__titlerow {
    flex-direction: row;
    align-items: center;
    margin-bottom: 4px;
}

/* The title row is the box's fold toggle, so it has to answer to the pointer like one. */
.zui-box__titlerow:hover {
    background-color: rgba(255, 255, 255, 0.05);
}

.zui-box__title {
    -unity-font-style: bold;
    white-space: nowrap;
}

/* Quieter than a section's caret — a box is already framed, so its title stays a sub-heading and
   doesn't take the section colour. */
.zui-box__caret {
    width: 12px;
    opacity: 0.5;
    -unity-text-align: middle-center;
}

/* A closed box is just its title row: give back the padding its body was using. */
.zui-box--closed {
    padding-bottom: 2px;
}

.zui-box--closed > .zui-box__titlerow {
    margin-bottom: 0;
}

/* A within-section divider: a hairline with real air around it, so a long flat column reads as grouped
   runs instead of one undifferentiated stack. Lighter than a nested box, stronger than bare whitespace. */
.zui-divider {
    height: 1px;
    background-color: var(--zui-line);
    margin-top: 7px;
    margin-bottom: 6px;
    flex-shrink: 0;
}

/* A labelled divider carries a small caption sitting on the line — names the group it introduces. */
.zui-divider--labelled {
    height: auto;
    background-color: rgba(0, 0, 0, 0);
    flex-direction: row;
    align-items: center;
    border-top-width: 1px;
    border-top-color: var(--zui-line);
    padding-top: 3px;
    margin-top: 8px;
}

.zui-divider__label {
    font-size: 10px;
    -unity-font-style: bold;
    opacity: 0.55;
    margin-right: 6px;
}

.zui-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 2px;
}

.zui-row > * {
    margin-right: 6px;
}

/* Text ------------------------------------------------------------------- */

/* Section headings read as the top of a block, so they get real size and real air ABOVE them —
   the gap belongs before the heading, not after it, because that is what separates this block from
   the previous one rather than pushing the heading away from what it names. */
.zui-text--section {
    -unity-font-style: bold;
    font-size: 13px;
    color: var(--zui-section-title);
    margin-top: 12px;
    margin-bottom: 4px;
    white-space: nowrap;
}

/* The heading is the fold toggle, so it has to look like it answers to the pointer. */
.zui-text--section:hover {
    background-color: rgba(255, 255, 255, 0.05);
}

/* Collapsible sections (ZuiSection) ---------------------------------------- */

.zui-section {
    margin-top: 12px;
    margin-bottom: 4px;
}

.zui-section__header {
    flex-direction: row;
    align-items: center;
    padding-top: 2px;
    padding-bottom: 3px;
    border-bottom-width: 1px;
    border-bottom-color: var(--zui-line);
    margin-bottom: 4px;
}

.zui-section__header:hover {
    background-color: rgba(255, 255, 255, 0.05);
}

.zui-section__caret {
    width: 14px;
    color: var(--zui-section-title);
    opacity: 0.75;
    -unity-text-align: middle-center;
}

.zui-section__title {
    -unity-font-style: bold;
    font-size: 13px;
    color: var(--zui-section-title);
    white-space: nowrap;
}

/* A closed section keeps its heading but gives back the gap its body was using. */
.zui-section--closed {
    margin-bottom: 0;
}

.zui-section--closed .zui-section__header {
    margin-bottom: 0;
    opacity: 0.75;
}

/* A section nested inside a box is a sub-section: quieter, and no competing rule line. */
.zui-box .zui-section {
    margin-top: 6px;
}

.zui-box .zui-section__header {
    border-bottom-width: 0;
}

.zui-text--small {
    font-size: 10px;
    opacity: 0.8;
    white-space: nowrap;
}

.zui-text--subtle {
    font-size: 10px;
    opacity: 0.6;
    white-space: normal;
    margin-bottom: 3px;
}

.zui-help {
    opacity: 0.55;
    -unity-font-style: bold;
    white-space: nowrap;
}

/* Field wrap (label + control pair — sidesteps BaseField's inconsistent built-in label widths) */

.zui-field {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
}

.zui-field__label {
    margin-right: 4px;
    white-space: nowrap;
    flex-shrink: 0;
    -unity-text-align: middle-left;
}

/* A label that folds/unfolds its control when clicked (envelope headers). */
.zui-fold-label:hover {
    color: var(--zui-accent);
}

/* Global row rhythm ------------------------------------------------------ */
/* Every top-level row control gets uniform breathing room below it, so a column of controls reads as
   distinct rows instead of a crammed stack. One value, applied to every tool's UI. Tune it here. */
.zui-field,
.zui-value,
.zui-fill,
.zui-microslider,
.zui-hgroup,
.zui-row {
    margin-bottom: 4px;
}

/* Don't double up: a row nested INSIDE a value/fill control (its header→envelope gap) stays tight —
   the whole control already owns the 4px below it. */
.zui-value .zui-row,
.zui-fill .zui-row {
    margin-bottom: 1px;
}

/* Custom-drawn controls (the old IMGUI ZUI look, Painter2D) ---------------- */

/* MicroSlider — a filled track whose fill IS the value; no thumb, label+value sit inside it. */
.zui-microslider {
    height: 18px;
    min-width: 60px;
    border-radius: 3px;
    overflow: hidden;
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    border-width: 1px;
    border-color: var(--zui-line);
}

.zui-microslider__caption {
    position: absolute;
    left: 6px;
    font-size: 11px;
    -unity-text-align: middle-left;
}

.zui-microslider__value {
    position: absolute;
    right: 6px;
    font-size: 11px;
    opacity: 0.85;
    -unity-text-align: middle-right;
}

/* Button-style Toggle — a button that stays pressed when on, no checkmark. */
.zui-togglebutton {
    -unity-font-style: normal;
    padding-left: 8px;
    padding-right: 8px;
    padding-top: 2px;
    padding-bottom: 2px;
    border-radius: 3px;
    background-color: var(--zui-bg-inset);
    border-width: 1px;
    border-color: var(--zui-line);
    flex-shrink: 0;
}

.zui-togglebutton:hover {
    background-color: rgba(255, 255, 255, 0.06);
}

.zui-togglebutton--on {
    background-color: var(--zui-accent-soft);
    border-color: var(--zui-accent);
    -unity-font-style: bold;
}

/* Segmented control — a joined row of buttons; single-select (radio) or multi-select. */
.zui-segmented {
    flex-direction: row;
    flex-shrink: 0;
}

.zui-segmented > .zui-segmented__seg {
    margin-left: 0;
    margin-right: 0;
    border-radius: 0;
    border-left-width: 0;
    padding-left: 8px;
    padding-right: 8px;
    background-color: var(--zui-bg-inset);
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-right-width: 1px;
    border-color: var(--zui-line);
}

.zui-segmented > .zui-segmented__seg.zui-segmented__first {
    border-left-width: 1px;
    border-top-left-radius: 3px;
    border-bottom-left-radius: 3px;
}

.zui-segmented > .zui-segmented__seg.zui-segmented__last {
    border-top-right-radius: 3px;
    border-bottom-right-radius: 3px;
}

.zui-segmented > .zui-segmented__seg.zui-segmented__on {
    background-color: var(--zui-accent-soft);
    -unity-font-style: bold;
}

.zui-segmented > .zui-segmented__seg:hover {
    background-color: rgba(255, 255, 255, 0.06);
}

.zui-segmented > .zui-segmented__seg.zui-segmented__on:hover {
    background-color: var(--zui-accent-soft);
}

/* Controls --------------------------------------------------------------- */

.zui-radio {
    flex-direction: row;
    flex-shrink: 0;
}

/* A long option set folds instead of running off the pane. flex-shrink is restored because a wrapped row
   is allowed to be as wide as its container and no wider — that is the whole point. */
.zui-radio--wrap {
    flex-wrap: wrap;
    flex-shrink: 1;
}

.zui-radio > .unity-button {
    margin-left: 0;
    margin-right: 0;
    border-radius: 0;
}

/* Unity USS has no :first-child/:last-child — Z.MiniRadio sets these classes explicitly. */
.zui-radio__first {
    border-top-left-radius: 3px;
    border-bottom-left-radius: 3px;
}

.zui-radio__last {
    border-top-right-radius: 3px;
    border-bottom-right-radius: 3px;
}

.zui-radio__on {
    background-color: var(--zui-accent-soft);
    -unity-font-style: bold;
}

/* A PropertyField built through ZuiSerialized already carries the label we gave it, so the field's
   own [Header] decorator would draw that same word a second time, right above it. */
.zui-no-decorators > .unity-decorator-drawers-container {
    display: none;
}

/* Managed reference ([SerializeReference] polymorphic field) --------------- */

.zui-mref {
    margin-top: 2px;
    margin-bottom: 4px;
}

.zui-mref__header {
    flex-direction: row;
    align-items: center;
    padding-top: 1px;
    padding-bottom: 1px;
}

.zui-mref__header:hover {
    background-color: rgba(255, 255, 255, 0.05);
}

.zui-mref__caret {
    width: 12px;
    opacity: 0.6;
    -unity-text-align: middle-center;
}

.zui-mref__title {
    -unity-font-style: bold;
    white-space: nowrap;
}

/* Quieter than a normal button — it names a type, it isn't the field's main action. */
.zui-mref__type {
    font-size: 10px;
    opacity: 0.9;
    max-width: 220px;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
}

/* The body sits under the header, indented so it reads as belonging to it. */
.zui-mref__body {
    padding-left: 12px;
    border-left-width: 1px;
    border-left-color: var(--zui-line);
    margin-left: 5px;
}

/* 2D pad + envelope ------------------------------------------------------ */

.zui-pad {
    background-color: var(--zui-bg-inset);
    border-width: 1px;
    border-color: var(--zui-line);
    flex-shrink: 0;
}

.zui-pad__dot {
    position: absolute;
    width: 6px;
    height: 6px;
    border-radius: 3px;
    background-color: rgb(102, 217, 255);
}

.zui-envelope {
    background-color: rgba(0, 0, 0, 0.35);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.08);
    flex-shrink: 0;
}

/* Reorderable rows -------------------------------------------------------- */

.zui-reorder__dragging {
    background-color: var(--zui-accent-soft);
}

.zui-reorder__line {
    background-color: var(--zui-accent);
}

/* Asset-window chrome ---------------------------------------------------- */

.zui-cell {
    flex-shrink: 0;
    margin-right: 4px;
    margin-bottom: 4px;
    align-items: center;
}

.zui-cell__thumb {
    background-color: var(--zui-bg-inset);
    justify-content: center;
    align-items: center;
}

.zui-cell--selected .zui-cell__thumb {
    background-color: var(--zui-accent-soft);
    border-width: 1px;
    border-color: var(--zui-accent);
}

.zui-cell__name {
    font-size: 10px;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
}

/* Stage / canvas --------------------------------------------------------- */

.zui-stage {
    background-color: var(--zui-stage-bg);
    flex-grow: 1;
    min-width: 200px;
    min-height: 200px;
}
