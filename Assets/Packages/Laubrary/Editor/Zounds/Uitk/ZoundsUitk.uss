.zs-root .zs-picker__flag { margin-left: 4px; }
.zs-root .zs-picker__filters { flex-wrap: wrap; }
.zs-root .zs-picker__label { color: rgb(170,170,180); font-size: 11px; margin: 0 4px 0 0; }
.zs-root .zs-picker__seg { height: 20px; flex-shrink: 0; }
.zs-root .zs-picker__flags { flex-direction: row; margin-left: 8px; flex-shrink: 0; }
