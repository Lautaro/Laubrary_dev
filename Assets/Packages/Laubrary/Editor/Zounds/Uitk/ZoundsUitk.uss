.zs-root.zs-browser__title-box-row, .zs-root .zs-browser__title-box-row { flex-direction: row; align-items: flex-start; min-width: 0; }
.zs-root .zs-browser__title-box-row > .zs-title { min-width: 0; flex-shrink: 1; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.zs-root.zs-browser__title-box-title, .zs-root .zs-browser__title-box-title { height: 18px; }
.zs-root.zs-browser__slider-settings-label, .zs-root .zs-browser__slider-settings-label { width: 80px; height: 18px; }
