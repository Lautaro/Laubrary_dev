.zs-root .zs-picker__grow { flex-grow: 1; }
.zs-root .zs-picker__body { flex-direction: row; flex-grow: 1; flex-shrink: 1; min-height: 100px; }
.zs-root .zs-picker__list-host { flex-grow: 1; flex-shrink: 1; min-width: 200px; background-color: rgba(0,0,0,0.18); border-width: 1px; border-color: rgba(255,255,255,0.06); }
.zs-root .zs-picker__list { flex-grow: 1; }
.zs-root .zs-picker__details { width: 300px; flex-shrink: 0; margin-left: 6px; padding: 6px; background-color: rgba(0,0,0,0.18); border-width: 1px; border-color: rgba(255,255,255,0.06); }
.zs-root .zs-picker__details-none { margin: 4px 0 0 0; white-space: normal; }
.zs-root .zs-picker__details-name { font-size: 14px; height: 22px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; margin-bottom: 4px; }
.zs-root .zs-picker__details-wave { width: auto; align-self: stretch; height: 80px; margin: 0 0 6px 0; flex-shrink: 0; }
.zs-root .zs-picker__details-line { flex-direction: row; height: 18px; flex-shrink: 0; }
.zs-root .zs-picker__details-label { width: 60px; flex-shrink: 0; color: rgb(160,160,172); font-size: 11px; }
.zs-root .zs-picker__details-value { flex-grow: 1; flex-shrink: 1; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; font-size: 11px; }
.zs-root .zs-picker__details-actions { flex-direction: row; margin-top: 8px; flex-shrink: 0; }
.zs-root .zs-picker__bottom { margin: 6px 0 0 0; }
.zs-root .zs-picker__action { margin-right: 4px; }
.zs-root .zs-picker__pick { margin-right: 6px; }
.zs-root .zs-picker__selected { width: 90px; flex-shrink: 0; -unity-text-align: middle-right; color: rgb(190,190,200); font-size: 11px; }
/* rows */
.zs-root .zs-picker__rowhost { flex-shrink: 0; }
.zs-root .zs-picker__header { height: 18px; margin: 2px 0 0 4px; font-size: 11px; -unity-font-style: bold; color: rgb(199,199,209); border-bottom-width: 1px; border-bottom-color: rgba(255,255,255,0.1); }
.zs-root .zs-picker__item { flex-direction: row; align-items: center; margin: 1px 2px 1px 2px; padding: 0 2px 0 2px; border-radius: 2px; }
.zs-root .zs-picker__item:hover { background-color: rgba(255,255,255,0.05); }
.zs-root .zs-picker__item--selected { background-color: rgba(51,97,140,0.55); }
.zs-root .zs-picker__item--selected:hover { background-color: rgba(51,97,140,0.7); }
.zs-root .zs-picker__item--cursor { border-width: 1px; border-color: rgba(76,153,255,0.6); }
.zs-root .zs-picker__item--missing .zs-picker__name { color: rgb(255,178,128); }
.zs-root .zs-picker__star { width: 16px; flex-shrink: 0; -unity-text-align: middle-center; color: rgb(120,120,130); font-size: 13px; }
.zs-root .zs-picker__star:hover { color: rgb(240,220,120); }
.zs-root .zs-picker__star--on { color: rgb(240,200,60); }
.zs-root .zs-picker__picked { width: 14px; flex-shrink: 0; -unity-text-align: middle-center; color: rgb(120,200,120); font-size: 11px; }
.zs-root .zs-picker__thumb { width: 72px; height: 22px; flex-shrink: 0; margin: 0 6px 0 2px; }
