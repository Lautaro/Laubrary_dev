/* Colorful's fixed action fills, pre-blended over its (32,79,124) border at the original 70% opacity. */
.zs-root .zs-browser__mute-visible.zs-Flat.unity-button { background-color: rgb(152.4,59.4,63.975); }
.zs-root .zs-browser__solo-visible.zs-Flat.unity-button { background-color: rgb(36.375,139.725,81.825); }

/* Keep long sound names inside their existing preview-button slots; the tooltip retains the full name. */
.zs-root .zs-browser__grid-button,
.zs-root .zs-zound-row__list-name-button {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

/* Non-destructive editing timeline (Zequence window): static layout lives here; per-frame geometry stays in code. */
.zs-root.zs-timeline-header, .zs-root .zs-timeline-header { flex-shrink: 0; }
.zs-root.zs-timeline-header__overview, .zs-root .zs-timeline-header__overview { flex-shrink: 0; margin-top: 3px; }
.zs-root.zs-timeline-header__ruler, .zs-root .zs-timeline-header__ruler { flex-shrink: 0; overflow: hidden; }
.zs-root.zs-timeline-header__edit-bar, .zs-root .zs-timeline-header__edit-bar { flex-direction: row; flex-shrink: 0; flex-wrap: nowrap; overflow: hidden; }
.zs-root.zs-timeline-header__control, .zs-root .zs-timeline-header__control { flex-shrink: 0; }
.zs-root .zs-lbl.zs-timeline-header__readout, .zs-root.zs-lbl.zs-timeline-header__readout { flex-grow: 1; flex-shrink: 1; min-width: 40px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; -unity-text-align: middle-left; }
.zs-root .zs-lbl.zs-timeline-header__tick-label, .zs-root.zs-lbl.zs-timeline-header__tick-label { position: absolute; font-size: 9px; top: -1px; color: rgba(255, 255, 255, 0.75); }
.zs-root.zs-track-strip, .zs-root .zs-track-strip { position: absolute; overflow: hidden; }
.zs-root .zs-lbl.zs-track-strip__warn, .zs-root.zs-lbl.zs-track-strip__warn { position: absolute; color: rgb(255, 191, 51); font-size: 11px; }
.zs-root.zs-track-strip__chips, .zs-root .zs-track-strip__chips { position: absolute; flex-direction: row; top: 0px; right: 2px; }
.zs-root.zs-track-strip__chip-button, .zs-root .zs-track-strip__chip-button { font-size: 9px; margin-left: 2px; }
.zs-root .zs-lbl.zs-track-strip__mark, .zs-root.zs-lbl.zs-track-strip__mark { position: absolute; top: 10px; font-size: 10px; color: rgba(204, 217, 255, 0.85); background-color: rgba(0, 0, 0, 0.35); }
.zs-root.zs-track-strip__curve, .zs-root .zs-track-strip__curve { position: absolute; }
/* The live readout of the track's sound's own values, floating in the lane's top-right corner while it plays. */
.zs-root .zs-lbl.zs-track-strip__live, .zs-root.zs-lbl.zs-track-strip__live { right: 2px; left: auto; top: 2px; padding: 0 3px 0 3px; white-space: nowrap; }
/* The one curve toolbar (CurveBarTK), shared by the Klip editor and every local track: small, one row. */
.zs-root.zs-curvebar, .zs-root .zs-curvebar { flex-direction: row; flex-shrink: 0; height: 16px; align-items: center; }
.zs-root .zs-curvebar__toggle.unity-button, .zs-root .zs-curvebar__toggle { font-size: 10px; padding-left: 3px; padding-right: 3px; }
/* A curve's three chips wear the colour the curve is drawn in (the colour itself is the Settings tab's, set in code):
   off = outline and text in it over the skin's dark face; on = a translucent fill of it with light text. The skin's
   orange "on" picture is turned off so the fill can show. Only the shape and the fixed text colour live here. */
.zs-root .zs-curvebar__toggle--curve.zui-togglebutton--on, .zs-root .zs-curvebar__toggle--curve.zui-togglebutton--on:hover, .zs-root .zs-curvebar__toggle--curve.zui-togglebutton--on:active { background-image: none; color: rgb(240,240,244); }
.zs-root .zs-curvebar__toggle--curve { border-width: 1px; }
.zs-root .zs-curvebar__pencil { position: absolute; left: 50%; top: 50%; width: 11px; height: 11px; translate: -50% -50%; }
.zs-root .zs-curvebar__gap { flex-shrink: 0; }
.zs-root .zs-lbl.zs-curvebar__warn { width: 12px; font-size: 10px; }
/* A curve's own settings card (right-click on its name in the bar). */
.zs-root .zs-curve-settings { padding: 6px; }
.zs-root .zs-curve-settings__row { flex-direction: row; height: 20px; align-items: center; margin-bottom: 4px; }
.zs-root .zs-lbl.zs-curve-settings__label { width: 70px; }
.zs-root .zs-lbl.zs-curve-settings__unit { width: 12px; padding-left: 3px; }
/* The Klip waveform's bottom grip: drag to set the area's height. */
.zs-root .zs-klip-waveform__grip { position: absolute; left: 0; right: 0; bottom: 0; height: 5px; cursor: resize-vertical; background-color: rgba(255,255,255,0.06); }
.zs-root .zs-klip-waveform__grip:hover { background-color: rgba(255,255,255,0.2); }
/* The audition card pinned into a window, under the toolbar. */
.zs-root .zs-klip-editor__pinned, .zs-root .zs-zequence-editor__pinned { flex-shrink: 0; }
.zs-root .zs-audition-card--pinned { margin: 4px 0 2px 0; flex-shrink: 0; }
/* Pinned in the Zequence editor: the helpers join the Play button's row, the second row sits right-aligned underneath. */
.zs-root .zs-zequence-editor__pinned-inline { flex-direction: row; flex-shrink: 0; height: 20px; }
.zs-root .zs-audition-card--under-play { align-items: flex-end; margin: 2px 0 0 0; }
/* The Zequence toolbar: one 20 px row. */
.zs-root .zs-lbl.zs-zequence-editor__toolbar-label { height: 20px; padding-right: 4px; -unity-text-align: middle-right; }
.zs-root .zs-zequence-editor__toolbar-field { height: 18px; margin-top: 1px; }
.zs-root .zs-zequence-editor__toolbar-mode { height: 20px; }
.zs-root .zs-zequence-editor__toolbar-row > * { flex-shrink: 0; }
.zs-root .zs-zequence-editor__toolbar-row > .zs-zequence-editor__spacer { flex-shrink: 1; min-width: 0; }
/* A track card: the reorder grip, the height grip along the bottom, the start box, the drop line while reordering. */
.zs-root .zs-lbl.zs-zequence-entry__grip { cursor: move-arrow; color: rgb(140,140,150); -unity-text-align: middle-center; font-size: 11px; padding: 0; }
.zs-root .zs-lbl.zs-zequence-entry__grip:hover { color: rgb(220,220,230); }
.zs-root .zs-zequence-entry__height-grip { position: absolute; cursor: resize-vertical; background-color: rgba(255,255,255,0.04); }
.zs-root .zs-zequence-entry__height-grip:hover { background-color: rgba(255,255,255,0.18); }
.zs-root .zs-zequence-entry__drop-line { position: absolute; left: 0; right: 0; height: 2px; background-color: rgb(120,180,255); }
.zs-root .zs-lbl.zs-zequence-entry__start-label { -unity-text-align: middle-right; padding-right: 2px; color: rgb(160,160,170); }
.zs-root .zs-zequence-entry__name.unity-button { -unity-text-align: middle-left; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; padding-left: 6px; }
.zs-root .zs-zequence-entry__curve-bar { position: absolute; }
.zs-root.zs-bake-popup, .zs-root .zs-bake-popup { padding-left: 6px; padding-right: 6px; padding-top: 6px; }
.zs-root.zs-bake-popup__row, .zs-root .zs-bake-popup__row { flex-direction: row; margin-bottom: 4px; }
.zs-root.zs-bake-popup__seed, .zs-root .zs-bake-popup__seed { width: 70px; margin-left: 6px; }
.zs-root.zs-bake-popup__name, .zs-root .zs-bake-popup__name { width: 250px; }
.zs-root.zs-bake-popup__go, .zs-root .zs-bake-popup__go { margin-left: 6px; }
.zs-root.zs-bake-popup__info, .zs-root .zs-bake-popup__info { white-space: nowrap; overflow: hidden; }

/* ── destructive editing (2026-10-09): the Klip editor's edit bar, edit cursor and selection, the source row's badge,
      the "Tell me" notice, the Settings row ── */
.zs-root.zs-klip-waveform__edit-bar, .zs-root .zs-klip-waveform__edit-bar { flex-direction: row; flex-shrink: 0; align-items: center; height: 18px; }
.zs-root.zs-klip-waveform__edit-button, .zs-root .zs-klip-waveform__edit-button { flex-shrink: 0; }
.zs-root .zs-klip-waveform__edit-bar .zs-klip-waveform__edit-readout { flex-grow: 1; flex-shrink: 1; min-width: 0; height: 18px; -unity-text-align: middle-left; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.zs-root.zs-klip-waveform__selection, .zs-root .zs-klip-waveform__selection { background-color: rgba(89, 158, 255, 0.30); border-left-width: 1px; border-right-width: 1px; border-left-color: rgba(128, 191, 255, 0.9); border-right-color: rgba(128, 191, 255, 0.9); }
.zs-root.zs-klip-waveform__edit-cursor, .zs-root .zs-klip-waveform__edit-cursor { width: 1px; background-color: rgba(255, 255, 255, 0.95); }
.zs-root.zs-klip-waveform__notice, .zs-root .zs-klip-waveform__notice { left: 6px; right: 6px; top: 6px; }
.zs-root.zs-zequence-editor__notice, .zs-root .zs-zequence-editor__notice { left: 8px; right: 8px; bottom: 6px; }
.zs-root.zs-swap-notice, .zs-root .zs-swap-notice { position: absolute; flex-direction: row; align-items: center; height: 22px; padding-left: 6px; padding-right: 3px; background-color: rgba(28, 42, 66, 0.95); border-left-width: 1px; border-right-width: 1px; border-top-width: 1px; border-bottom-width: 1px; border-left-color: rgba(110, 160, 230, 0.9); border-right-color: rgba(110, 160, 230, 0.9); border-top-color: rgba(110, 160, 230, 0.9); border-bottom-color: rgba(110, 160, 230, 0.9); border-top-left-radius: 3px; border-top-right-radius: 3px; border-bottom-left-radius: 3px; border-bottom-right-radius: 3px; }
.zs-root .zs-swap-notice .zs-swap-notice__text { flex-grow: 1; flex-shrink: 1; min-width: 0; color: rgb(220, 232, 255); -unity-text-align: middle-left; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.zs-root .zs-swap-notice .zs-swap-notice__button, .zs-root .zs-swap-notice .zs-swap-notice__close { flex-shrink: 0; margin-left: 4px; }
.zs-root .zs-klip-editor__source-row .zs-klip-editor__badge { flex-grow: 1; flex-shrink: 1; min-width: 0; margin-left: 8px; -unity-text-align: middle-left; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.zs-root .zs-klip-editor__badge.zs-klip-editor__badge--locked { color: rgb(170, 190, 225); }
.zs-root.zs-klip-editor__badge, .zs-root .zs-klip-editor__badge { -unity-text-align: middle-left; margin-left: 8px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.zs-root.zs-settings__protected-edits, .zs-root .zs-settings__protected-edits { width: 210px; flex-shrink: 0; height: 18px; }
