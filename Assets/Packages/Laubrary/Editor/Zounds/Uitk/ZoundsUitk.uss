/* Colour settings (2026-10-08): a label column, then ZUI's colour swatch at a fixed width (never stretched across the pane);
   a drawn line's row puts its thickness box between them. */
.zs-root.zs-settings__thickness-color-row, .zs-root .zs-settings__thickness-color-row, .zs-root .zs-settings__color-row { flex-direction: row; align-items: center; }
