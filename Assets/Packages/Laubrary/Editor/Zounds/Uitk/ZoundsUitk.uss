.zs-root .zs-chain-editor__empty { margin-left: 4px; }

/* ── The picker for clips and sounds (2026-10-08): search and filter strip, a virtualised list beside a details pane, a bottom row of actions. ── */
.zs-root.zs-picker__root, .zs-root .zs-picker__root { flex-grow: 1; padding: 4px 6px 4px 6px; }
.zs-root .zs-picker__top { flex-shrink: 0; }
