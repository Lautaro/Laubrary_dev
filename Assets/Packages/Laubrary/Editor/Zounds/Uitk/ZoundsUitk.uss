/* Settings rows on ZUI controls (2026-10-08): a label column, then controls at their own widths, nothing stretched. */
.zs-root .zs-settings__row { flex-direction: row; align-items: center; }
.zs-root .zs-settings__row-label { flex-shrink: 0; }
